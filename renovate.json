{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "kubernetes": {
    "managerFilePatterns": ["/clusters/**/.yaml", "/clusters/**/*.yml"]
  },
  "helmv3": {
    "fileMatch": ["(^|/)Chart\\.yaml$"]
  },
  "labels": ["renovate"],
  "prConcurrentLimit": 5
}
