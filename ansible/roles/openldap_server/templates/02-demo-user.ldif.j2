dn: cn={{ openldap_demo_groupname }},ou=groups,{{ ldap_base_dn }}
objectClass: posixGroup
cn: {{ openldap_demo_groupname }}
gidNumber: {{ openldap_demo_gid }}

dn: uid={{ openldap_demo_username }},ou=users,{{ ldap_base_dn }}
objectClass: inetOrgPerson
objectClass: posixAccount
uid: {{ openldap_demo_username }}
sn: {{ openldap_demo_username }}
cn: {{ openldap_demo_username }}
