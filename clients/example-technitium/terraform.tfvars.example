# Copy to dns/terraform/environments/technitium/terraform.tfvars (do not commit secrets).

zone_name = "lab.internal"

# Optional: zone already exists on server
# create_zone = false

records = {
  gateway = {
    name  = "gw.lab.internal"
    type  = "A"
    value = "192.168.20.1"
    ttl   = 300
  }
  k3s_api = {
    name  = "k3s.lab.internal"
    type  = "A"
    value = "192.168.20.10"
  }
}
